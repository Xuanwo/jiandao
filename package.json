{
  "name": "@jiandao/extension",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Translates the web page you are reading, and does nothing else.",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:analyze": "wxt build --analyze",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm test:e2e:built",
    "test:e2e:built": "node --test --test-timeout=120000 scripts/e2e/*.e2e.mjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "schema:setup": "UPDATE_SETUP_SCHEMA=1 vitest run src/utils/__tests__/setup-schema.test.ts"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.5",
    "jotai": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-rem-to-responsive-pixel": "^7.0.5",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wxt": "0.21.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "download"
    }
  }
}
