{
  "name": "@plainly/extension",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Translates the web page you are reading, and does nothing else.",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:analyze": "wxt build --analyze",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm test:e2e:built",
    "test:e2e:built": "node --test --test-timeout=120000 scripts/e2e/*.e2e.mjs",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "scrape:ai-sdk-models": "npx tsx scripts/scrape-ai-sdk-provider-models.ts --out scripts/output/ai-sdk-provider-models.json",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.36",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@babel/runtime": "^7.29.7",
    "@base-ui/react": "^1.5.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@uiw/codemirror-extensions-color": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@webext-core/messaging": "^3.0.2",
    "@wxt-dev/i18n": "^0.2.5",
    "ai": "^6.0.201",
    "case-anything": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "deepmerge-ts": "^7.1.5",
    "defuddle": "^0.18.1",
    "dequal": "^2.0.3",
    "dexie": "^4.4.3",
    "file-saver": "^2.0.5",
    "jotai": "^2.20.1",
    "jotai-family": "^1.0.2",
    "js-sha256": "^0.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-react/eslint-plugin": "^5.8.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/css-tree": "^2.3.11",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "nx": "^22.7.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.15",
    "postcss-rem-to-responsive-pixel": "^7.0.4",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "0.20.26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "download"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wxt build"
        }
      },
      "build:firefox": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wxt build -b firefox"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run"
        }
      },
      "test:cov": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --coverage"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint"
        }
      },
      "type-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit"
        }
      }
    }
  }
}
