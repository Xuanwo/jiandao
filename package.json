{
  "name": "@plainly/extension",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Translates the web page you are reading, and does nothing else.",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:analyze": "wxt build --analyze",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm test:e2e:built",
    "test:e2e:built": "node --test --test-timeout=120000 scripts/e2e/*.e2e.mjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "prepare": "git config core.hooksPath .githooks",
    "schema:setup": "UPDATE_SETUP_SCHEMA=1 vitest run src/utils/__tests__/setup-schema.test.ts"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.5",
    "defuddle": "^0.18.1",
    "jotai": "^2.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.15",
    "postcss-rem-to-responsive-pixel": "^7.0.4",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "0.20.26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "download"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wxt build"
        }
      },
      "build:firefox": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wxt build -b firefox"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run"
        }
      },
      "test:cov": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --coverage"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint"
        }
      },
      "type-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit"
        }
      }
    }
  }
}
